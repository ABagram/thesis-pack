* {
    font-family: "Poppins";
}

QPushButton#WidgetDeleteButton,
QLabel#IconLabel,
QLabel[icon="true"] {
    font-family: "Material Symbols Rounded";
}

QFrame#Sidebar {
    background-color: #f8fafc;
    border: none;
    border-radius: 5px;
    margin: 10px;
    padding: 10px;
    color: #181818;
}

QComboBox{
    font-size: 11px;
    padding: 2px 5px;
    min-width: 90px;
    max-width: 120px;
}

QPushButton {
    color: white;
    background-color: transparent;
    border: none;
    text-align: left;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #34495e;
}

#projectsContainer{
    background-color: red;
    height: 20px;
    border-radius: 5px;
}

#badge{
    border-radius: 4px;
    height: 50px;
}

QFrame#BatchFrame{
    background-color: #0d166534;
    color: #166534;
    border: 1px solid #1a166534;
    border-radius: 5px;
    padding: 10px;
}

QLabel#BatchTitle{
    color: #166534;
}

QLabel#BatchCount{
    font-size: 11px; 
    font-weight: bold; 
    color: #166534; 
    background-color: transparent; 
    border: 1px solid #1a166534; 
    border-radius: 9px; 
    padding: 1px 7px;
}

QLabel#BatchInfo{
    font-size: 12px;
    padding: 6px;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
}

QFrame#QueueFrame{
    background: #f8f9fa;
    border-top: 1px solid #bdc3c7;
}

/*Specific instances of CopyStringWidget*/
QPushButton#SSIDDetail, QPushButton#PasswordDetail{
    background-color: #0d166534;
    color: #166534;
    border: 1px solid #1a166534;
    border-radius: 5px;
    padding: 4px;
}

/*WifiStatusWidget*/
QFrame#WifiStatusWidget{
    background-color: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 4px 10px;
}

QLabel#SystemIcon{
    color: #0F172A;
    border: none;
    background: transparent;
    text-align: left;
    padding: 0;
    font-size: 14px;
    font-family: Material Symbols Rounded;
}

QLabel#SystemName{
    font-size: 11px;
    font-weight: bold;
    color: #475569;
    border: none;
    background: transparent;
    text-align: left;
    padding: 0;
    font-size: 12px;
}

QLabel#Connect_Status_Mismatch{
    color: #ff4d00;
}

QPushButton#SetupWifiConnection{
    font-size: 11px;
    padding: 4px 8px;
    background-color: #2563EB;
    color: white;
    border-radius: 4px;
    border: none;
}

QLabel#WifiStatusWidget_SSID_Name{
    font-size: 10px;
    color: #64748B;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 4px 8px;
}