QWidget#MainWindow {
    background: $bg_slate_50;
}

QFrame#Sidebar {
    background-color: $bg_brand_dark;
    border: none;
    border-radius: 5px;
    margin: 10px;
    padding: 10px;
    color: #181818;
}

QComboBox{
    font-size: 11px;
    padding: 2px 5px;
    min-width: 90px;
    max-width: 120px;
}

QComboBox {
    border: 1px solid gray;
    border-radius: 3px;
    padding: 1px 18px 1px 3px;
    min-width: 6em;
}

QComboBox:editable {
    background: white;
}

QComboBox:!editable, QComboBox::drop-down:editable {
     background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                 stop: 0 #E1E1E1, stop: 0.4 #DDDDDD,
                                 stop: 0.5 #D8D8D8, stop: 1.0 #D3D3D3);
}

/* QComboBox gets the "on" state when the popup is open */
QComboBox:!editable:on, QComboBox::drop-down:editable:on {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #D3D3D3, stop: 0.4 #D8D8D8,
                                stop: 0.5 #DDDDDD, stop: 1.0 #E1E1E1);
}

QComboBox:on { /* shift the text when the popup opens */
    padding-top: 3px;
    padding-left: 4px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 15px;

    border-left-width: 1px;
    border-left-color: darkgray;
    border-left-style: solid; /* just a single line */
    border-top-right-radius: 3px; /* same radius as the QComboBox */
    border-bottom-right-radius: 3px;
}

QComboBox::down-arrow {
    image: url(/usr/share/icons/crystalsvg/16x16/actions/1downarrow.png);
}

QComboBox::down-arrow:on { /* shift the arrow when popup is open */
    top: 1px;
    left: 1px;
}

QPushButton {
    color: white;
    background-color: transparent;
    border: none;
    text-align: left;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #34495e;
}

#projectsContainer{
    background-color: red;
    height: 20px;
    border-radius: 5px;
}

#badge{
    border-radius: 4px;
    height: 50px;
}

QFrame#BatchFrame{
    background-color: #facc15;
    color: #166534;
    border: 1px solid #1a166534;
    border-radius: 5px;
    padding: 10px;
}

QLabel#BatchTitle{
    color: #166534;
}

QLabel#BatchCount{
    font-size: 11px; 
    font-weight: bold; 
    color: #166534; 
    background-color: white; 
    border: 1px solid #1a166534; 
    border-radius: 9px; 
    padding: 1px 7px;
}

QLabel#BatchInfo{
    font-size: 12px;
    padding: 6px;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
}

QFrame#QueueFrame{
    background: #f8f9fa;
    border-top: 1px solid #bdc3c7;
}

/*Specific instances of CopyStringWidget*/
QPushButton#SSIDDetail, QPushButton#PasswordDetail{
    background-color: #0d166534;
    color: #166534;
    border: 1px solid #1a166534;
    border-radius: 5px;
    padding: 4px;
}

/*WifiStatusWidget*/
QFrame#WifiStatusWidget{
    background-color: white;
    border: 1px solid #f3f4f6;
    border-radius: 12px;
    padding: 10px;
}

QLabel#SystemIcon{
    color: #0F172A;
    border: none;
    background: transparent;
    text-align: left;
    padding: 0;
    font-size: 14px;
    font-family: Material Symbols Rounded;
}

QLabel#SystemName{
    font-size: 14px;
    font-weight: bold;
    color: #0f172a;
    border: none;
    background: transparent;
    text-align: left;
    padding: 0;
    width: 30px;
    line-height: 10px;
}

QLabel#Connect_Status_Mismatch{
    color: #ff4d00;
}

QLabel#WifiStatusWidget_SSID_Name{
    font-size: 10px;
    color: $text_slate_600;
    background: $bg_slate_50;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 4px 8px;
}