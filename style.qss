QFrame#Sidebar {
    background-color: #efedeb;
    border: none;
    border-radius: 5px;
    margin: 10px;
    padding: 10px;
    color: #181818;
}

QPushButton {
    color: white;
    background-color: transparent;
    border: none;
    text-align: left;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #34495e;
}

#projectsContainer{
    background-color: red;
    height: 20px;
    border-radius: 5px;
}

#badge{
    border-radius: 4px;
    height: 50px;
}

QFrame#BatchFrame{
    background-color: white;
    border: none;
    border-radius: 5px;
    padding: 10px;
}

QFrame#QueueFrame{
    background: #f8f9fa;
    border-top: 1px solid #bdc3c7;
}