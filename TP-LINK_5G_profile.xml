                        </authEncryption>

                        <sharedKey>
                            <keyType>passPhrase</keyType>
                            <protected>false</protected>
                            <keyMaterial>PLDTWIFIF89F5</keyMaterial>
                        </sharedKey>
                    </security>
                </MSM>
                

    </WLANProfile>
    