        <name>TP-LINK_5G</name>

        <SSIDConfig>
            <SSID>
                <name>TP-LINK_5G</name>
            </SSID>
        </SSIDConfig>

        <connectionType>ESS</connectionType>
        <connectionMode>auto</connectionMode>

        
                <MSM>
                    <security>
                        <authEncryption>
